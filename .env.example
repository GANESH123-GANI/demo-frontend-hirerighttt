# Frontend → API Connection
VITE_API_URL=http://localhost:8787
PORT=8787

# ─── Supabase (Auth + Postgres + sync) ───
VITE_AUTH_PROVIDER=supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Node API (server only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=your_jwt_secret
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Leave local auth: VITE_AUTH_PROVIDER=local (omit Supabase vars)

# OpenRouter AI Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_BASE_URL=https://api.experientiallabs.ai/v1
OPENROUTER_MODEL=openrouter/free

# ExperientialLabs AI — server key required in production (see .env.production.example)
EXPERIENTIALLABS_API_KEY=your_xpl_api_key_here
# Dev-only browser fallback (omit in production Docker builds)
VITE_EXPERIENTIALLABS_API_KEY=your_xpl_api_key_here
VITE_EXPERIENTIALLABS_BASE_URL=https://api.experientiallabs.ai/v1
VITE_EXPERIENTIALLABS_MODEL=gpt-6-luna
# VITE_ALLOW_CLIENT_LLM=true  # never enable in public production
