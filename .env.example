# Frontend → API Connection
VITE_API_URL=http://localhost:8787
PORT=8787

# ─── Supabase (Auth + Postgres + sync) ───
VITE_AUTH_PROVIDER=supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Node API (server only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=your_jwt_secret
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Leave local auth: VITE_AUTH_PROVIDER=local (omit Supabase vars)

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
PRIMARY_MODEL=gemini-2.5-flash
FALLBACK_MODEL=gemini-1.5-flash
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional fallback keys
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Dev-only browser fallback (omit in production builds)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_PRIMARY_MODEL=gemini-2.5-flash
VITE_FALLBACK_MODEL=gemini-1.5-flash
# VITE_ALLOW_CLIENT_LLM=true  # never enable in public production
