# ─── Supabase production (recommended) ───
# Deploy: docker compose -f docker-compose.supabase.prod.yml up -d --build

ENVIRONMENT=production

# Supabase → Settings → Database → Connection pooling (Transaction mode, port 6543)
DATABASE_URL=postgresql://postgres.[ref]:[YOUR_PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Supabase → Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=your-legacy-jwt-secret-from-api-settings
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key
VITE_AUTH_PROVIDER=supabase

# 32+ chars: openssl rand -base64 48
SESSION_SECRET=change-me-use-openssl-rand-base64-48

# Live site URL(s), comma-separated — no wildcards
CORS_ORIGINS=https://app.yourdomain.com

# Same host nginx proxy: leave empty. Cross-origin API: https://api.yourdomain.com
PUBLIC_API_URL=

WEB_PORT=8080
ALLOW_DEMO_ACCOUNTS=false
SIGNUP_ENABLED=true
TRUST_PROXY=true

# Server-side only — never VITE_ prefix in production builds
GEMINI_API_KEY=your_gemini_api_key_here
PRIMARY_MODEL=gemini-2.5-flash
FALLBACK_MODEL=gemini-1.5-flash
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional admin tasks (never expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=

# ─── Self-hosted Postgres (optional) ───
# docker compose -f docker-compose.prod.yml --profile self-hosted-db up -d --build
# POSTGRES_DB=hireright
# POSTGRES_USER=hireright
# POSTGRES_PASSWORD=change-me-long-random-password
